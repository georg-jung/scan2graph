# scan2graph configuration example. Every value is synthetic - none of it
# points at a real tenant, host or secret. Copy to .env, or set these as real
# environment variables.
#
# scan2graph also reads this file itself, when pointed at one:
#     scan2graph --config /etc/scan2graph/scan2graph.env
# Real environment variables win; see "A configuration file" in README.md.
# `scan2graph setup` serves a web form that writes it instead.
#
# The printer's sender address picks features among those configured below
# (scan@... gets all of them); see the README's "Sender address" section.

# ---------------------------------------------------------------------------
# Listeners
# ---------------------------------------------------------------------------

# SMTP listener for the printer/scanner, and HTTP listener for the web UI +
# health checks. Defaults shown.
S2G_HTTP_ADDR=:8080
S2G_SMTP_ADDR=:2525

# SMTP AUTH: the printer signs in as user "scanner" with this password. Leave
# it unset and scan2graph instead generates a random ephemeral password and
# prints it on every start.
#S2G_SMTP_PASSWORD=replace-me
# Set to true to disable SMTP AUTH entirely - mutually exclusive with
# S2G_SMTP_PASSWORD. Only do this on a fully trusted, isolated LAN segment;
# see the README's security assumptions.
#S2G_SMTP_ALLOW_ANONYMOUS=false

# Public URL of this service behind the reverse proxy that terminates TLS;
# setting it turns the web UI on. An absolute http(s) URL, a host of its own
# or a plain subpath (https://nas.acme.office/scanner/) that the proxy must
# forward unchanged. See README's "Reverse proxy".
S2G_PUBLIC_BASE_URL=https://scan2graph.example.com

# debug | info | warn | error. Defaults to info.
S2G_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Recipients
# ---------------------------------------------------------------------------

# Comma-separated list of domains (no "@", matched case-insensitively,
# exact match only - no subdomain wildcards) that envelope recipients are
# allowed to belong to. Required whenever email delivery is enabled -
# scan2graph would otherwise be an open mail relay.
S2G_ALLOWED_RECIPIENT_DOMAINS=example.com

# ---------------------------------------------------------------------------
# Entra ID (identity) - always required
# ---------------------------------------------------------------------------

S2G_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
S2G_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
S2G_ENTRA_CLIENT_SECRET=replace-me

# ---------------------------------------------------------------------------
# Email delivery via Microsoft Graph
# ---------------------------------------------------------------------------

# Mailbox scan2graph sends scans from via Graph sendMail; setting it
# (together with the allowlist above) is what turns email delivery on.
S2G_GRAPH_SENDER=scanner@example.com

# ---------------------------------------------------------------------------
# Azure Document Intelligence (OCR) - setting it is what turns OCR on
# ---------------------------------------------------------------------------

# Absolute https URL of your Document Intelligence resource. A trailing
# slash is stripped automatically.
S2G_DI_ENDPOINT=https://replace-me.cognitiveservices.azure.com

# ---------------------------------------------------------------------------
# Lifetimes and limits (defaults shown)
# ---------------------------------------------------------------------------

# How long a web-visible job (and its temp files) stays around once it is
# ready to download; must be at least 1 minute. Email-only jobs are deleted
# right after successful send regardless of this setting.
S2G_JOB_TTL=8h
# SMTP DATA cap. A decoded attachment is always smaller than the message
# that carried it, so this also bounds PDF sizes.
S2G_MAX_MESSAGE_BYTES=33554432
# Temporary space for queued, in-flight and web-visible scans together; at
# least twice S2G_MAX_MESSAGE_BYTES. Full, it removes finished scans, oldest
# first, to make room for an accepted one.
S2G_MAX_STORED_BYTES=536870912
