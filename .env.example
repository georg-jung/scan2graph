# scan2graph configuration example.
#
# Copy this file to .env and fill in real values, or set these as real
# environment variables / container secrets. Every value below is synthetic
# (example.com, scanner.local, all-zero GUIDs, "replace-me") - none of it
# points at a real tenant, host or secret.
#
# Values are used verbatim, the way Docker (`--env-file`) and Docker Compose
# (`env_file:`) pass them on. Note that the JSON values below are NOT quoted,
# because those loaders do not run a shell: if you instead `source` this file
# in a shell, wrap every JSON value in single quotes first.
#
# Any S2G_X variable may instead be supplied as S2G_X_FILE, pointing at a
# file whose content (trailing whitespace/newlines trimmed) is used as the
# value. Setting both S2G_X and S2G_X_FILE at the same time is a startup
# error. This is the preferred way to feed the client secret in via Docker
# secrets - see S2G_ENTRA_CLIENT_SECRET_FILE below.

# ---------------------------------------------------------------------------
# Listeners
# ---------------------------------------------------------------------------

# SMTP listener for the printer/scanner, and HTTP listener for the web UI +
# health checks. Defaults shown.
S2G_HTTP_ADDR=:8080
S2G_SMTP_ADDR=:2525

# SMTP AUTH for the scanner's SMTP client. Username defaults to "scanner"
# and is only meaningful once a password is set.
#S2G_SMTP_USERNAME=scanner
# Set a real password here for a deployment that should keep working
# across restarts without reconfiguring the printer's SMTP client. Leave
# this (and S2G_SMTP_PASSWORD_FILE) unset and scan2graph instead generates
# a random ephemeral password and prints it to the log on every start.
#S2G_SMTP_PASSWORD=replace-me
# Set to true to disable SMTP AUTH entirely - mutually exclusive with
# S2G_SMTP_USERNAME/S2G_SMTP_PASSWORD being set. Only do this on a fully
# trusted, isolated LAN segment; see the README's security assumptions.
#S2G_SMTP_ALLOW_ANONYMOUS=false

# Public URL of this service as seen through the reverse proxy that
# terminates TLS. Required if a sender profile has "web" enabled; with no
# profiles configured, setting it is what turns the web UI on.
# Must be an absolute http(s) URL addressing the root of a host, with no
# path, query string or fragment; a trailing slash is stripped
# automatically. Give scan2graph its own hostname rather than a path prefix
# under an existing one.
S2G_PUBLIC_BASE_URL=https://scan2graph.example.com

# Directory scan2graph keeps its own "scan2graph" temp subdirectory in. It
# is wiped on every start, so nothing survives a restart. Defaults to the OS
# temp directory if unset.
#S2G_TEMP_DIR=/tmp

# debug | info | warn | error. Defaults to info.
S2G_LOG_LEVEL=info
# json | text. Defaults to json.
S2G_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Sender profiles & recipient identity
# ---------------------------------------------------------------------------

# Optional. JSON object mapping an SMTP envelope-sender address (one per
# printer "scan to" button / feature combination) to the capabilities it
# enables. Every profile needs at least one of email/web/ocr set to true.
# Configure one printer sender address per entry; once this is set, an
# unrecognized envelope sender is rejected at SMTP time.
#
# Leave it unset and every sender gets the same treatment, with each
# feature enabled exactly when the configuration it needs is present: email
# once S2G_GRAPH_SENDER and S2G_ALLOWED_RECIPIENT_DOMAINS are set, web
# downloads once S2G_PUBLIC_BASE_URL is set, OCR once S2G_DI_ENDPOINT is
# set. scan2graph prints the resulting profile at startup. That is all most
# setups need.
#S2G_PROFILES={"scan-email-ocr@scanner.local":{"email":true,"web":false,"ocr":true},"scan-web-ocr@scanner.local":{"email":false,"web":true,"ocr":true},"scan-web@scanner.local":{"email":false,"web":true,"ocr":false}}

# Optional. JSON object mapping a shorthand alias address (e.g. what a
# printer's limited address book can store) to the canonical identity
# address of the Entra user it should resolve to. Defaults to {}. Applied
# exactly once - alias chains are not followed.
S2G_RECIPIENT_ALIASES={"printer-shortcut@scanner.local":"jane.doe@example.com"}

# Comma-separated list of domains (no "@", matched case-insensitively,
# exact match only - no subdomain wildcards) that envelope recipients are
# allowed to belong to. Required whenever email delivery is enabled -
# scan2graph would otherwise be an open mail relay.
S2G_ALLOWED_RECIPIENT_DOMAINS=example.com

# ---------------------------------------------------------------------------
# Entra ID (identity) - required whenever at least one profile is configured
# ---------------------------------------------------------------------------

S2G_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
S2G_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Prefer the _FILE form so the secret never ends up in process listings,
# shell history, or a plain environment variable dump - e.g. with a Docker
# secret mounted at /run/secrets/entra_client_secret:
#S2G_ENTRA_CLIENT_SECRET_FILE=/run/secrets/entra_client_secret
S2G_ENTRA_CLIENT_SECRET=replace-me

# Optional overrides. Default to the standard Entra v2 endpoints derived
# from S2G_ENTRA_TENANT_ID above; only set these to point at a local fake
# Entra for the e2e test harness (http is accepted there for that reason).
#S2G_ENTRA_AUTHORITY_URL=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
#S2G_ENTRA_TOKEN_URL=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/token

# ---------------------------------------------------------------------------
# Microsoft Graph - required whenever any profile has "email" enabled
# ---------------------------------------------------------------------------

#S2G_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
#S2G_GRAPH_SCOPE=https://graph.microsoft.com/.default

# Mailbox scan2graph sends scans from via Graph sendMail. Required if a
# sender profile has "email" enabled; with no profiles configured, setting
# it (together with the allowlist above) is what turns email delivery on. A mailbox address/UPN.
S2G_GRAPH_SENDER=scanner@example.com

# ---------------------------------------------------------------------------
# Azure Document Intelligence (OCR) - required whenever a profile asks for
# "ocr"; with no profiles configured, setting it is what turns OCR on
# ---------------------------------------------------------------------------

# Absolute https URL of your Document Intelligence resource. A trailing
# slash is stripped automatically.
S2G_DI_ENDPOINT=https://replace-me.cognitiveservices.azure.com
#S2G_DI_API_VERSION=2024-11-30
#S2G_DI_SCOPE=https://cognitiveservices.azure.com/.default

# ---------------------------------------------------------------------------
# Lifetimes
# ---------------------------------------------------------------------------

# How long a web-visible job (and its temp files) stays around; must be at
# least 1 minute. Email-only jobs are deleted right after successful send
# regardless of this setting. Defaults to 90m.
S2G_JOB_TTL=90m

# ---------------------------------------------------------------------------
# Limits (all must be > 0; defaults shown)
# ---------------------------------------------------------------------------

# SMTP DATA cap. A decoded attachment is always smaller than the message
# that carried it, so this also bounds PDF sizes.
S2G_MAX_MESSAGE_BYTES=33554432
# Queued + in-flight + web-visible jobs.
S2G_MAX_JOBS=32
# Pipeline workers.
S2G_MAX_CONCURRENT_JOBS=2
